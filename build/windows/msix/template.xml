<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path=".xray-manager.exe"
        Arguments=""
        InstallLocation="C:\Program Files\xray-manager\xray-manager">
    </Installer>
    <PackageInformation
        PackageName="xray-manager"
        PackageDisplayName="xray-manager"
        PublisherName="CN=xray-manager"
        PublisherDisplayName="xray-manager"
        Version="2.2.0.0"
        PackageDescription="Xray 代理管理工具，支持多规则配置与一键切换">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.wails..xray-manager"
                Description="Xray 代理管理工具，支持多规则配置与一键切换"
                DisplayName="xray-manager"
                ExecutableName=".xray-manager.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>xray-manager</DisplayName>
            <PublisherDisplayName>xray-manager</PublisherDisplayName>
            <Description>Xray 代理管理工具，支持多规则配置与一键切换</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath=".xray-manager.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
